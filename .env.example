# The restaurant
RESTAURANT_NAME="Luigi's Trattoria"
OFFER="Free appetizer tonight"
TIMEZONE=America/New_York
DEFAULT_COUNTRY_CODE=1

# Where this app is online (used for the QR code), and the owner's login for /admin
PUBLIC_URL=https://your-app.example.com
ADMIN_PASSWORD=change-me
PORT=3000

# Claude writes the texts (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Twilio sends the texts (https://console.twilio.com). Leave empty to test without sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
